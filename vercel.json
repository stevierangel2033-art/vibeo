{
  "cleanUrls": true,
  "redirects": [
    { "source": "/start", "destination": "/#buy", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(admin|thanks)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
